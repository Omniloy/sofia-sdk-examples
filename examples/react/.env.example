# Sofia SDK Development Environment Configuration

# API Configuration
# VITE_BASE_URL is optional — leave empty unless Omniloy tells you your key needs it
VITE_BASE_URL=''
VITE_API_KEY='YOUR_API_KEY'

# User / Patient
VITE_USER_ID='YOUR_USER_ID'
VITE_PATIENT_ID='YOUR_PATIENT_ID'
VITE_TEMPLATE_ID='YOUR_TEMPLATE_ID'
# Optional (SDK 1.0.9+) — doctor's specialty, attached to tracked events for analytics
VITE_USER_MEDICAL_SPECIALTY=''

# Development Settings
VITE_DEBUG=true
